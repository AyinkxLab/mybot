# Copy this file to ".env" and fill in your values.

# API key for your LLM provider (OpenAI, OpenRouter, Groq, DeepSeek, etc.)
LLM_API_KEY=sk-your-key-here

# Base URL. Leave default for OpenAI. Examples:
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Ollama:     http://localhost:11434/v1   (key can be "ollama")
LLM_BASE_URL=https://api.openai.com/v1

# Model name
LLM_MODEL=gpt-4o-mini

# Root folder the bot may read/write and run commands in.
# For full-machine access set it to a drive root, e.g. C:\
# WARNING: this lets the bot touch every file that drive, subject to your user rights.
BOT_WORKSPACE=workspace

# Set to "false" to disable shell command execution
ALLOW_SHELL=true

# When true, git push / PRs / GitHub writes pause for your approval.
# Set to "false" for a fully autonomous (and riskier) agent.
REQUIRE_APPROVAL=true

# Optional: GitHub fine-grained PAT for issue-solving.
# Scope it to only the target repo with: Contents (rw), Issues (rw), Pull requests (rw).
GITHUB_TOKEN=

# Optional: Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Optional: Discord bot token
DISCORD_TOKEN=
