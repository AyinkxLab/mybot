# Copy this file to ".env" and fill in your values.

# API key for your LLM provider (OpenAI, OpenRouter, Groq, DeepSeek, etc.)
LLM_API_KEY=sk-your-key-here

# Base URL. Leave default for OpenAI. Examples:
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Ollama:     http://localhost:11434/v1   (key can be "ollama")
LLM_BASE_URL=https://api.openai.com/v1

# Model name
LLM_MODEL=gpt-4o-mini

# Folder the bot is allowed to read/write and run commands in.
BOT_WORKSPACE=workspace

# Set to "false" to disable shell command execution
ALLOW_SHELL=true

# Optional: Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Optional: Discord bot token
DISCORD_TOKEN=
