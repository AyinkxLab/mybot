# Copy this file to ".env" and fill in your values.

# API key for your LLM provider (OpenAI, OpenRouter, Groq, DeepSeek, etc.)
LLM_API_KEY=sk-your-key-here

# Base URL. Leave default for OpenAI. Examples:
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Ollama:     http://localhost:11434/v1   (key can be "ollama")
LLM_BASE_URL=https://api.openai.com/v1

# Model name
LLM_MODEL=gpt-4o-mini

# Local-first fallback: used automatically if the primary provider fails.
# Defaults to a local Ollama (auto-detects the first installed model if unset).
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_API_KEY=ollama
LLM_FALLBACK_MODEL=

# Optional cheap/fast model for short, simple turns (per-task routing).
LLM_MODEL_FAST=

# Stop sending prompts once the session cost reaches this many USD (0 = off).
MAX_SESSION_COST=0

# Max tool-call rounds per turn (generous; lower it to cap runaway loops).
MAX_TOOL_ROUNDS=1000

# Root folder the bot may read/write and run commands in.
# For full-machine access set it to a drive root, e.g. C:\
# WARNING: this lets the bot touch every file that drive, subject to your user rights.
BOT_WORKSPACE=workspace

# Set to "false" to disable shell command execution
ALLOW_SHELL=true

# When true, git push / PRs / GitHub writes pause for your approval.
# Set to "false" for a fully autonomous (and riskier) agent.
REQUIRE_APPROVAL=true

# Allow http_get to reach private/loopback addresses (SSRF risk). Default false.
ALLOW_PRIVATE_HTTP=false

# Max chat sessions kept in memory by the chat adapters.
MAX_SESSIONS=50

# Optional: GitHub fine-grained PAT for issue-solving.
# Scope it to only the target repo with: Contents (rw), Issues (rw), Pull requests (rw).
GITHUB_TOKEN=

# Optional: Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# REQUIRED if you run the Telegram bot: numeric user IDs allowed to use it.
# Leave empty and ANYONE who finds the bot gets shell access to your PC.
TELEGRAM_ALLOWED_IDS=

# Optional: Discord bot token. Requires the privileged Message Content Intent.
DISCORD_TOKEN=

# REQUIRED if you run the Discord bot: numeric user IDs allowed to use it.
DISCORD_ALLOWED_IDS=
